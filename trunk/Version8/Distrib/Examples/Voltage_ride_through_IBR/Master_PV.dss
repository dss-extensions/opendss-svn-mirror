Clear
New Circuit.tyn_substation


Redirect Vsource.dss
Redirect WireData.dss
Redirect LineSpacing.dss
Redirect LineCode.dss
Redirect LoadShape.dss
Redirect GrowthShape.dss
Redirect TCC_Curve.dss
Redirect Spectrum.dss
Redirect Line.dss
Redirect Load.dss
Redirect Transformer.dss
Redirect RegControl.dss
Redirect Capacitor.dss
Redirect CapControl.dss

Redirect PVDynamics.dss
MakeBusList
Redirect BusVoltageBases.dss  ! set voltage bases
Buscoords BusCoords.dss
GIScoords GISCoords.dss

!Redirect EnergyMeters.dss

!set loadmult=2.8

batchedit load..* vmaxpu=1.3
batchedit load..* vminpu=0.2

vsource.source.pu=1.01
set controlmode=off

solve

/*
!Dynamics case

set mode=dynamics stepsize=0.002s number=200 time=(12,0)
solve

vsource.source.pu=1.12
set number=1005
solve

vsource.source.pu=1.01

! This is to bring back the device to generate
!PVSystem.tyn202_x_2_023_a41222-1_0.SafeMode=No

set number=200
solve

export monitors all
*/


/*
! QSTS simulation case
set mode=yearly stepsize=0.01s number=200 time=(12,0)

solve

vsource.source.pu=0.4
set number=121
solve

vsource.source.pu=1.01

! This is to bring back the device to generate
!PVSystem.tyn202_x_2_023_a41222-1_0.SafeMode=No

set number=200
solve

export monitors all

*/





